// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  CLIENT
}

model User {
  id        String    @id @default(cuid())
  name      String
  lastname  String
  email     String    @unique
  password  String
  role      Role
  active    Boolean   @default(true)
  //Campos de timestap
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  // Un usuario puede registrar muchas propiedades
  properties     Property[]
  // Un usuario puede generar muchos registros en el historial
  requestHistory RequestHistory[]

  @@map("user")
}

enum PropertyStatus {
  AVAILABLE // disponible
  RESERVED // apartado
  RENTED // rentado
  UNAVAILABLE // no disponible temporalmente
}

enum PropertyType {
  LOCAL
  OFFICE
  WAREHOUSE
}

model Property {
  id              String         @id @default(cuid())
  title           String
  description     String?
  price           Decimal        @db.Decimal(10, 2)
  maintenanceCost Decimal?       @db.Decimal(10, 2)
  dimensions      String?
  floor           Int?
  type            PropertyType
  status          PropertyStatus @default(AVAILABLE)
  amenities       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime?      @updatedAt

  // El administrador que registró el inmueble  
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Una propiedad tiene una dirección
  address Address?

  // Una propiedad puede tener muchas imágenes
  //images Image[]

  // Una propiedad puede tener muchas solicitudes
  requests Request[]

  @@map("property")
}

model Address {
  id      String @id @default(cuid())
  street  String
  city    String
  state   String
  zipCode String

  // Una dirección pertenece a una propiedad
  propertyId String   @unique
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("address")
}

// model Image {
//   id  String @id @default(cuid())
//   url String

//   // Una imagen pertenece a un inmueble
//   propertyId String
//   property   Property @relation(fields: [propertyId], references: [id])
// }

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLIST
}

model Request {
  id         String        @id @default(cuid())
  nombre     String
  apellidos  String
  telefono   String
  correo     String
  propertyId String
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())

  history  RequestHistory[]
  property Property         @relation(fields: [propertyId], references: [id])

  @@map("request")
}

enum RequestAction {
  CREATED
  APPROVED
  REJECTED
  UPDATED
  CANCELLED
}

model RequestHistory {
  id        String        @id @default(cuid())
  action    RequestAction
  changedAt DateTime      @default(now())

  // Muchos registros de historial pertenecen a una solicitud
  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  // Muchos registros de historial pueden pertenecer al mismo usuario
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("requesthistory")
}
